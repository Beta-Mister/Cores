<misterromdescription>
    <about author="javitu" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Funky Jet (Japan, rev 2)</name>
    <setname>funkyjetj</setname>
    <mameversion>0282</mameversion>
    <year>1992</year>
    <manufacturer>Mitchell (Data East Corporation license)</manufacturer>
    <players>2</players>
    <rbf>funkyjet</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="funkyjetj.zip|funkyjet.zip" md5="None">
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="jh01-2.13f" crc="21280220" map="01"/>
            <part name="jh00-2.11f" crc="5b98b700" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- chars - starts at 0x80000 - length 0x80000 (19 bits) -->
        <interleave output="32">
            <part name="mat02" crc="e4b94c7e" map="0021" length="0x40000"/>
            <part name="mat02" crc="e4b94c7e" map="2100" length="0x40000" offset="0x40000"/>
        </interleave>
        <!-- JTFRAME_BA2_START -->
        <!-- sprites - starts at 0x100000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="mat01" crc="24093a8d" map="0021" length="0x80000"/>
            <part name="mat00" crc="fbda0228" map="2100" length="0x80000"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- audiocpu - starts at 0x200000 - length 0x10000 (16 bits) -->
        <part name="jh02.16f" crc="748c0bd8"/>
        <!-- PCM_START -->
        <!-- oki - starts at 0x210000 - length 0x20000 (17 bits) -->
        <part name="jh03.15h" crc="69a0eaf7"/>
        <!-- Total 0x230000 bytes - 2240 kBytes -->
    </rom>
    <nvram index="2" size="45056"/>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,fe">
        <DSW/>
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Coin B" bits="2,4" ids="3/1,1/4,1/6,1/2,2/1,1/3,1/5,1/1"/>
        <dip name="Coin A" bits="5,7" ids="3/1,1/4,1/6,1/2,2/1,1/3,1/5,1/1"/>
        <dip name="Demo Sounds" bits="8" ids="On,Off"/>
        <dip name="Allow Continue" bits="9" ids="No,Yes"/>
        <dip name="Free Play" bits="10" ids="On,Off"/>
        <dip name="Freeze" bits="11" ids="On,Off"/>
        <dip name="Difficulty" bits="12,13" ids="Hardest,Easy,Hard,Normal"/>
        <dip name="Lives" bits="14,15" ids="4,3,1,2"/>
    </switches>
    <buttons names="Jet,Unused,Unused,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
