<misterromdescription>
    <about author="javitu" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Puzzle &amp; Action: Tant-R (Japan) (bootleg set 3)</name>
    <setname>tantrbl3</setname>
    <mameversion>0282</mameversion>
    <year>1994</year>
    <manufacturer>bootleg</manufacturer>
    <players>2</players>
    <rbf>tantr</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="tantrbl3.zip|tantr.zip" md5="None">
        <!-- byte 0 [1:0]: proteccion 317-0211. 0=sin prot (tantrbl/tantrbl4) 1=317-0211 (tantr,tantrbl2,tantrbl3) 2=tantrkor
0[1:0]: prot       Variante de PAL de proteccion 317-0211 -->
        <part>
            01 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x200000 (21 bits) -->
        <interleave output="16">
            <part name="1.u28" crc="3304556d" map="01"/>
            <part name="2.u29" crc="faecb7b1" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="3.u30" crc="36a88bd4" map="01"/>
            <part name="4.u31" crc="17b80202" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- upd - starts at 0x200000 -->
        <!-- Total 0x200000 bytes - 2048 kBytes -->
    </rom>
    <nvram index="2" size="65536"/>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,fe">
        <COINAGE/>
        <dip name="Coin A" bits="0,3" ids="Free Play or 1/1,1/1 2/3,1/1 4/5,1/1 5/6,2/1 4/3,2/1 5/3 6/4,2/3,4/1,3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip name="Coin B" bits="4,7" ids="Free Play or 1/1,1/1 2/3,1/1 4/5,1/1 5/6,2/1 4/3,2/1 5/3 6/4,2/3,4/1,3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <DSW/>
        <dip name="Demo Sounds" bits="8" ids="On,Off"/>
        <dip name="Difficulty" bits="9,10" ids="Hardest,Hard,Easy,Medium"/>
    </switches>
    <buttons names="Action,Start,Coin,Core credits" default="A,Start,Select,-" count="1"/>
</misterromdescription>
