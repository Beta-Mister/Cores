            <part name="sfiii2-simm2.1" crc="67585033" map="0001"/>
            <part name="sfiii2-simm2.0" crc="94a4ce0f" map="0010"/>
            <part name="sfiii2-simm2.3" crc="623c09ca" map="0100"/>
            <part name="sfiii2-simm2.2" crc="fabffcd5" map="1000"/>
        </interleave>
        <!-- gfx3 - starts at 0x1080000 -->
        <!-- simm3.? - starts at 0x1080000 - length 0x1000000 (24 bits) -->
        <interleave output="16">
            <part name="sfiii2-simm3.0" crc="dab2d766" map="01"/>
            <part name="sfiii2-simm3.1" crc="1f2aa34b" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii2-simm3.2" crc="6f1a04eb" map="01"/>
