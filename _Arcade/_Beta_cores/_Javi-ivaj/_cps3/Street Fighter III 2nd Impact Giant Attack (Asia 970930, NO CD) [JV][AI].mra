<misterromdescription>
    <about author="javi" webpage="https://github.com/javi-ivaj" twitter="-" source="https://github.com/javi-ivaj"/>
    <rotation>horizontal</rotation>
    <name>Street Fighter III 2nd Impact: Giant Attack (Asia 970930, NO CD) [JV][AI]</name>
    <setname>sfiii2n</setname>
    <mameversion>0282</mameversion>
    <year>1997</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <rbf>jvcps3</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" address="0x30000000" zip="sfiii2n.zip|sfiii2.zip" md5="None">
        <!--     byte 0x00-0x0d: offsets >>11 de bios, programa, simm3..simm7
    byte 0x10-0x13: key1   byte 0x14-0x17: key2 (cifrado CPS3)
    byte 0x18:      modo cifrado: 1=normal, 2=alt (sin cifrar), 0=ninguno
    byte 0x19:      bit7=SIMM2 presente, bits5:0=ultimo banco GFX de 2 MiB
 -->
        <part>
            00 00 01 00 21 00 41 00
            61 00 81 00 81 00 00 00
            00 00 00 00 00 00 00 00
            02 97 00 00 00 00 00 00
        </part>
        <!-- bios - starts at 0x0 - length 0x80000 (19 bits) -->
        <part name="sfiii2_asia_nocd.29f400.u2" crc="fd297c0d"/>
        <!-- simm1.? - starts at 0x80000 - length 0x800000 (23 bits) -->
        <interleave output="32">
            <part name="sfiii2-simm1.1" crc="2a3a8ef6" map="0001"/>
            <part name="sfiii2-simm1.0" crc="2d666f0b" map="0010"/>
            <part name="sfiii2-simm1.3" crc="87ded8a3" map="0100"/>
            <part name="sfiii2-simm1.2" crc="161d2206" map="1000"/>
        </interleave>
        <!-- simm2.? - starts at 0x880000 - length 0x800000 (23 bits) -->
