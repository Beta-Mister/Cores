<misterromdescription>
    <about author="javi" webpage="https://github.com/javi-ivaj" twitter="-" source="https://github.com/javi-ivaj"/>
    <rotation>horizontal</rotation>
    <name>Street Fighter III: New Generation (Asia 970204, NO CD, BIOS set 2) [JV][AI]</name>
    <setname>sfiiina</setname>
    <mameversion>0282</mameversion>
    <year>1997</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <rbf>jvcps3</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" address="0x30000000" zip="sfiiina.zip|sfiii.zip" md5="None">
        <!--     byte 0x00-0x0d: offsets >>11 de bios, programa, simm3..simm7
    byte 0x10-0x13: key1   byte 0x14-0x17: key2 (cifrado CPS3)
    byte 0x18:      modo cifrado: 1=normal, 2=alt (sin cifrar), 0=ninguno
    byte 0x19:      bit7=SIMM2 presente, bits5:0=ultimo banco GFX de 2 MiB
 -->
        <part>
            00 00 01 00 11 00 31 00
            51 00 59 00 59 00 00 00
            B5 FE 05 3E FC 03 92 5A
            01 11 00 00 00 00 00 00
        </part>
        <!-- bios - starts at 0x0 - length 0x80000 (19 bits) -->
        <part name="sfiii_asia_nocd.29f400.u2" crc="73e32463"/>
        <!-- simm1.? - starts at 0x80000 - length 0x800000 (23 bits) -->
        <interleave output="32">
            <part name="sfiii-simm1.1" crc="57920546" map="0001"/>
            <part name="sfiii-simm1.0" crc="cfc9e45a" map="0010"/>
            <part name="sfiii-simm1.3" crc="ea4ca054" map="0100"/>
            <part name="sfiii-simm1.2" crc="0d8f2680" map="1000"/>
        </interleave>
        <!-- gfx3 - starts at 0x880000 -->
        <!-- simm3.? - starts at 0x880000 - length 0x1000000 (24 bits) -->
        <interleave output="16">
            <part name="sfiii-simm3.0" crc="080b3bd3" map="01"/>
            <part name="sfiii-simm3.1" crc="5c356f2f" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii-simm3.2" crc="f9c97a45" map="01"/>
            <part name="sfiii-simm3.3" crc="09de3ead" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii-simm3.4" crc="7dd7e1f3" map="01"/>
            <part name="sfiii-simm3.5" crc="47a03a3a" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii-simm3.6" crc="e9eb7a26" map="01"/>
            <part name="sfiii-simm3.7" crc="7f44395c" map="10"/>
        </interleave>
        <!-- gfx4 - starts at 0x1880000 -->
        <!-- simm4.? - starts at 0x1880000 - length 0x1000000 (24 bits) -->
        <interleave output="16">
            <part name="sfiii-simm4.0" crc="9ac080fc" map="01"/>
            <part name="sfiii-simm4.1" crc="6e2c4c94" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii-simm4.2" crc="8afc22d4" map="01"/>
            <part name="sfiii-simm4.3" crc="9f3873b8" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii-simm4.4" crc="166b3c97" map="01"/>
            <part name="sfiii-simm4.5" crc="e5ea2547" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sfiii-simm4.6" crc="e85b9fdd" map="01"/>
            <part name="sfiii-simm4.7" crc="362c01b7" map="10"/>
        </interleave>
        <!-- gfx5 - starts at 0x2880000 -->
        <!-- simm5.? - starts at 0x2880000 - length 0x400000 (22 bits) -->
        <interleave output="16">
            <part name="sfiii-simm5.0" crc="9bc108b2" map="01"/>
            <part name="sfiii-simm5.1" crc="c6f1c066" map="10"/>
        </interleave>
        <!-- gfx6 - starts at 0x2C80000 -->
        <!-- gfx7 - starts at 0x2C80000 -->
        <!-- Total 0x2C80000 bytes - 45568 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <buttons names="Jab Punch,Strong Punch,Fierce Punch,Short Kick,Forward Kick,Roundhouse Kick,Start,Coin,Core credits" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>
</misterromdescription>
