            <part name="jojo-simm3.7" crc="56fe1a9f" map="10"/>
        </interleave>
        <!-- gfx4 - starts at 0x2080000 -->
        <!-- simm4.? - starts at 0x2080000 - length 0x1000000 (24 bits) -->
        <interleave output="16">
            <part name="jojo-simm4.0" crc="c4e7bf68" map="01"/>
            <part name="jojo-simm4.1" crc="b62b2719" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="jojo-simm4.2" crc="18d15809" map="01"/>
            <part name="jojo-simm4.3" crc="9af0ad79" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="jojo-simm4.4" crc="4124c1f0" map="01"/>
            <part name="jojo-simm4.5" crc="5e001fd1" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="jojo-simm4.6" crc="9affa23b" map="01"/>
            <part name="jojo-simm4.7" crc="2511572a" map="10"/>
        </interleave>
        <!-- gfx5 - starts at 0x3080000 -->
        <!-- simm5.? - starts at 0x3080000 - length 0x400000 (22 bits) -->
        <interleave output="16">
            <part name="jojo-simm5.0" crc="797615fc" map="01"/>
            <part name="jojo-simm5.1" crc="734fd162" map="10"/>
        </interleave>
        <!-- gfx6 - starts at 0x3480000 -->
        <!-- gfx7 - starts at 0x3480000 -->
        <!-- Total 0x3480000 bytes - 53760 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
