    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <rbf>jvcps3</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" address="0x30000000" zip="redearthnr1.zip|redearth.zip" md5="None">
        <!--     byte 0x00-0x0d: offsets >>11 de bios, programa, simm3..simm7
    byte 0x10-0x13: key1   byte 0x14-0x17: key2 (cifrado CPS3)
    byte 0x18:      modo cifrado: 1=normal, 2=alt (sin cifrar), 0=ninguno
    byte 0x19:      bit7=SIMM2 presente, bits5:0=ultimo banco GFX de 2 MiB
 -->
        <part>
            00 00 01 00 11 00 31 00
            51 00 59 00 59 00 00 00
            9E 30 0A B1 A1 75 B8 2C
            01 11 00 00 00 00 00 00
        </part>
        <!-- bios - starts at 0x0 - length 0x80000 (19 bits) -->
        <part name="redearth_asia_nocd.29f400.u2" crc="7a4f0851"/>
        <!-- simm1.? - starts at 0x80000 - length 0x800000 (23 bits) -->
        <interleave output="32">
            <part name="redearthr1-simm1.1" crc="a8ec4aae" map="0001"/>
            <part name="redearthr1-simm1.0" crc="65bac346" map="0010"/>
            <part name="redearthr1-simm1.3" crc="13ebc21d" map="0100"/>
            <part name="redearthr1-simm1.2" crc="2caf8995" map="1000"/>
        </interleave>
        <!-- gfx3 - starts at 0x880000 -->
        <!-- simm3.? - starts at 0x880000 - length 0x1000000 (24 bits) -->
        <interleave output="16">
            <part name="redearth-simm3.0" crc="83350cc5" map="01"/>
            <part name="redearth-simm3.1" crc="56734de6" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="redearth-simm3.2" crc="800ea0f1" map="01"/>
            <part name="redearth-simm3.3" crc="97e9146c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="redearth-simm3.4" crc="0cb1d648" map="01"/>
            <part name="redearth-simm3.5" crc="7a1099f0" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="redearth-simm3.6" crc="aeff8f54" map="01"/>
            <part name="redearth-simm3.7" crc="f770acd0" map="10"/>
        </interleave>
        <!-- gfx4 - starts at 0x1880000 -->
        <!-- simm4.? - starts at 0x1880000 - length 0x1000000 (24 bits) -->
        <interleave output="16">
            <part name="redearth-simm4.0" crc="301e56f2" map="01"/>
            <part name="redearth-simm4.1" crc="2048e103" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="redearth-simm4.2" crc="c9433455" map="01"/>
            <part name="redearth-simm4.3" crc="c02171a8" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="redearth-simm4.4" crc="2ddbf276" map="01"/>
            <part name="redearth-simm4.5" crc="fea820a6" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="redearth-simm4.6" crc="c7528df1" map="01"/>
            <part name="redearth-simm4.7" crc="2449cf3b" map="10"/>
        </interleave>
        <!-- gfx5 - starts at 0x2880000 -->
        <!-- simm5.? - starts at 0x2880000 - length 0x400000 (22 bits) -->
        <interleave output="16">
            <part name="redearth-simm5.0" crc="424451b9" map="01"/>
            <part name="redearth-simm5.1" crc="9b8cb56b" map="10"/>
        </interleave>
        <!-- gfx6 - starts at 0x2C80000 -->
