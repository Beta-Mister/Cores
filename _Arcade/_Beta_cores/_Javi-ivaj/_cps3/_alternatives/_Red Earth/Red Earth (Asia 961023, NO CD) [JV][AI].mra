<misterromdescription>
    <about author="javi" webpage="https://github.com/javi-ivaj" twitter="-" source="https://github.com/javi-ivaj"/>
    <rotation>horizontal</rotation>
    <name>Red Earth (Asia 961023, NO CD) [JV][AI]</name>
    <setname>redearthnr1</setname>
