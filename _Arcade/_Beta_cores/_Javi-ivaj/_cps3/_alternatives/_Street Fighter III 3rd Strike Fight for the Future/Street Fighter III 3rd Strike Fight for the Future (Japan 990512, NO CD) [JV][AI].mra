<misterromdescription>
    <about author="javi" webpage="https://github.com/javi-ivaj" twitter="-" source="https://github.com/javi-ivaj"/>
    <rotation>horizontal</rotation>
    <name>Street Fighter III 3rd Strike: Fight for the Future (Japan 990512, NO CD) [JV][AI]</name>
