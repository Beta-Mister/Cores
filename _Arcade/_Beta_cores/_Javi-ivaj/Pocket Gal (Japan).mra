<misterromdescription>
    <about author="javitu" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Pocket Gal (Japan)</name>
    <setname>pcktgal</setname>
    <mameversion>0282</mameversion>
    <year>1987</year>
    <manufacturer>Data East Corporation</manufacturer>
    <players>2</players>
    <rbf>pcktgal</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="pcktgal.zip" md5="None">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="eb04.j7" crc="8215d60d"/>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="eb03.f2" crc="cb029b02"/>
        <!-- JTFRAME_BA2_START -->
        <!-- chars - starts at 0x20000 - length 0x20000 (17 bits) -->
        <interleave output="32">
            <part name="eb01.d11" crc="63542c3d" map="0001" length="0x8000" offset="0x8000"/>
            <part name="eb02.d12" crc="a9dcd339" map="0010" length="0x8000" offset="0x8000"/>
            <part name="eb01.d11" crc="63542c3d" map="0100" length="0x8000"/>
            <part name="eb02.d12" crc="a9dcd339" map="1000" length="0x8000"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x40000 - length 0x10000 (16 bits) -->
        <interleave output="16">
            <part name="eb00.a1" crc="6c1a14a8" map="01" length="0x8000"/>
            <part name="eb00.a1" crc="6c1a14a8" map="10" length="0x8000" offset="0x8000"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- proms - starts at 0x50000 - length 0x400 (10 bits) -->
        <part name="eb05.k14" crc="3b6198cb"/>
        <part name="eb06.k15" crc="1fbd4b59"/>
        <!-- Total 0x50400 bytes - 321 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="bf">
        <DSW/>
        <dip name="Coinage" bits="0,1" ids="2/1,1/3,1/2,1/1"/>
        <dip name="Flip Screen" bits="2" ids="On,Off"/>
        <dip name="Allow 2 Players Game" bits="3" ids="No,Yes"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Time" bits="5" ids="100,120"/>
        <dip name="Lives" bits="6" ids="3,4"/>
    </switches>
    <buttons names="Shot,View,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
