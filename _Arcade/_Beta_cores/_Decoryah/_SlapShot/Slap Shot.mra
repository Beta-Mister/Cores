<misterromdescription>
    <name>Slap Shot (Ver 3.0 O)</name>
    <setname>slapshot</setname>
    <rbf>slapshot</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <platform>Taito</platform>
    <!--
      Image for the slapshot core (rtl/system_consts.sv, tools/slapshot_rom.py); made by tools/make_mra.py from MAME 0.289
      (src/mame/taito/slapshot.cpp).  The settings are kept in the game's timekeeper (MAME: "DIPs in nvram"): set them in the
      game's test mode (OSD Test switch, or F2) and they are saved with the NVRAM file.
    -->
    <buttons names="Shot,Pass,Start,Coin" default="A,B,Start,Select"/>
    <rom index="0" zip="slapshot.zip" md5="73c83f2336dedca4cfc90f5537d2e664" address="0x30000000">
        <!-- board configuration: game 0, flags 0 (bit 0: the gun board) -->
        <part>00 00</part>
        <!-- region 0: maincpu, the 68000 program, 1048576 bytes -->
        <part>00 10 00 00</part>
        <interleave output="16">
            <part name="promat.ic1" crc="4d404f76" map="01"/>
            <part name="promat.ic3" crc="58e61833" map="10"/>
        </interleave>
        <!-- region 1: tc0480scp, the tilemaps, 1048576 bytes -->
        <part>01 10 00 00</part>
        <interleave output="32">
            <part name="d71-04.79" crc="b727b81c" map="1200"/>
            <part name="d71-05.80" crc="7b0f5d6d" map="0012"/>
        </interleave>
        <!-- region 2: sprites (4 bpp) + sprites_hi (2 bpp): 6 bpp words, 4194304 bytes -->
        <part>02 40 00 00</part>
        <interleave output="32">
            <part name="d71-02.24" crc="ccaaea2d" map="0001"/>
            <part name="d71-01.23" crc="0b1e8c27" map="0010"/>
            <part name="d71-03.25" crc="dccef9ec" map="0100"/>
            <part name="d71-03.25" crc="dccef9ec" map="1000"/>
        </interleave>
        <!-- region 3: audiocpu, the Z80 program, 65536 bytes -->
        <part>03 01 00 00</part>
        <part name="d71-07.77" crc="dd5f670c"/>
        <!-- region 4: ymsnd:adpcma, the ADPCM-A samples, 524288 bytes -->
        <part>04 08 00 00</part>
        <part name="d71-06.37" crc="f3324188"/>
    </rom>
    <nvram index="4" size="8192"/>
</misterromdescription>
