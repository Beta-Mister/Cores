<misterromdescription>
    <name>Speed Up (Version 2.20)</name>
    <setname>speedup</setname>
    <rbf>gaelco3d</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Gaelco</manufacturer>
    <rotation>horizontal</rotation>
    <region>World</region>
    <platform>Gaelco 3D</platform>

    <!--
      The game. Index 0 goes to the DDR3 (fast load), index 1 to the SDRAM, index 2 is the EEPROM, index 3
      the game (0 Speed Up).

      Index 0:
        0x0000000  32 MB   texture ROM (four parity quarters of 8 MB; the 16 MB board's ROMs twice each)
        0x2000000  512 KB  texture mask ROM

      Index 1 (fast load too; each 16-bit word low byte first):
        0x0000000  16 MB   TMS ROM (MAME's tmsrom: 32-bit words, ic32 the low half, ic33 the high half; 4 MB used)
        0x1000000  16 KB   the TMS320C31's boot loader (MAME's tms320c31.zip: c31boot.bin)
        0x1400000  2 MB    68000 program (ic10 the even bytes, ic15 the odd; the second MB empty)
        0x1800000  4 MB    the ADSP-2115's ROM (its program and samples)

      Needs the MiSTer SDRAM module.
    -->

    <rom index="3" md5="None"><part>00</part></rom>

    <rom index="0" zip="speedup.zip" md5="None" address="0x32000000">
        <!-- texture: 32 MB -->
        <part name="sup_ic12.ic12" crc="311f3247"/>
        <part name="sup_ic12.ic12" crc="311f3247"/>
        <part name="sup_ic14.ic14" crc="3ad3c089"/>
        <part name="sup_ic14.ic14" crc="3ad3c089"/>
        <part name="sup_ic11.ic11" crc="b993e65a"/>
        <part name="sup_ic11.ic11" crc="b993e65a"/>
        <part name="sup_ic13.ic13" crc="ad00023c"/>
        <part name="sup_ic13.ic13" crc="ad00023c"/>
        <!-- texture mask: 512 KB -->
        <part name="ic35.bin" crc="34737d1d"/>
        <part name="ic34.bin" crc="e89e829b"/>
        <part repeat="0x40000">00</part>
    </rom>

    <rom index="1" zip="speedup.zip|tms320c31.zip" md5="None" address="0x36000000">
        <!-- TMS ROM -->
        <interleave output="32">
            <part name="sup_ic32.ic32" crc="aed151de" map="0021"/>
            <part name="sup_ic33.ic33" crc="9be6ab7d" map="2100"/>
        </interleave>
        <part repeat="0xC00000">00</part>
        <!-- the TMS's boot loader -->
        <part name="c31boot.bin" crc="bddc2763"/>
        <part repeat="0x3FC000">00</part>
        <!-- 68000 program -->
        <interleave output="16">
            <part name="sup_2.2_10.ic10" crc="ee781e64" map="10"/>
            <part name="sup_2.2_15.ic15" crc="1b8ff9d2" map="01"/>
        </interleave>
        <part repeat="0x100000">00</part>
        <part repeat="0x200000">00</part>
        <!-- the sound CPU's ROM -->
        <part name="sup_ic25.ic25" crc="284c7cd1"/>
    </rom>

    <nvram index="2" size="512"/>

    <buttons names="Gas,Brake,Gear,View,Start,Coin,Service" default="A,B,X,Y,Start,Select,L"/>
</misterromdescription>
