<misterromdescription>
    <name>Radikal Bikers (Version 2.02)</name>
    <setname>radikalb</setname>
    <rbf>gaelco3d020</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Gaelco</manufacturer>
    <rotation>horizontal</rotation>
    <region>World</region>
    <platform>Gaelco 3D</platform>

    <!--
      The game (the 68EC020 board). Index 0 goes to the DDR3 (fast load), index 1 to the SDRAM, index 2 is the EEPROM,
      index 3 the game (2: its CPU and inputs).

      Index 0:
        0x0000000  32 MB   texture ROM
        0x2000000  512 KB  texture mask ROM

      Index 1 (fast load too; each 16-bit word low byte first):
        0x0000000  16 MB   TMS ROM (MAME's tmsrom: 32-bit words, rab_ic48.ic48 the low half, rab_ic45.ic45 the high half)
        0x1000000  16 KB   the TMS320C31's boot loader (MAME's tms320c31.zip: c31boot.bin)
        0x1400000  2 MB    68EC020 program (the four ROMs' bytes 0-3 of each long word; each 16-bit word big-endian)
        0x1800000  4 MB    the ADSP-2115's ROM (its program and samples)

      Needs the MiSTer SDRAM module.
    -->

    <rom index="3" md5="None"><part>02</part></rom>

    <rom index="0" zip="radikalb.zip" md5="None" address="0x32000000">
        <!-- texture: 32 MB -->
        <part name="rab_ic8.ic8" crc="4fbd4737"/>
        <part name="rab_ic9.ic9" crc="9e3e038d"/>
        <part name="rab_ic10.ic10" crc="870b0ce4"/>
        <part name="rab_ic11.ic11" crc="75672271"/>
        <part name="rab_ic15.ic15" crc="edb9d409"/>
        <part name="rab_ic16.ic16" crc="9d595e46"/>
        <part name="rab_ic17.ic17" crc="e120236b"/>
        <part name="rab_ic18.ic18" crc="3084bc49"/>
        <!-- texture mask: 512 KB -->
        <part name="rab_24.ic24" crc="2984bc1d"/>
        <part name="rab_25.ic25" crc="777758e3"/>
        <part name="rab_26.ic26" crc="bd9c1b54"/>
        <part name="rab_27.ic27" crc="bbcf6977"/>
    </rom>

    <rom index="1" zip="radikalb.zip|tms320c31.zip" md5="None" address="0x36000000">
        <!-- TMS ROM -->
        <interleave output="32">
            <part name="rab_ic48.ic48" crc="9c56a06a" map="0021"/>
            <part name="rab_ic45.ic45" crc="7e698584" map="2100"/>
        </interleave>
        <part repeat="0x800000">00</part>
        <!-- the TMS's boot loader -->
        <part name="c31boot.bin" crc="bddc2763"/>
        <part repeat="0x3FC000">00</part>
        <!-- 68EC020 program: bytes 0, 1, 2, 3 of each long word -->
        <interleave output="32">
            <part name="rab_6.ic6" crc="ccac98c5" map="0010"/>
            <part name="rab_12.ic12" crc="26199506" map="0001"/>
            <part name="rab_14.ic14" crc="4a0ac8cb" map="1000"/>
            <part name="rab_19.ic19" crc="c2d4fcb2" map="0100"/>
        </interleave>
        <part repeat="0x200000">00</part>
        <!-- the sound CPU's ROM -->
        <part name="rab_ic23.ic23" crc="dcf52520"/>
    </rom>

    <nvram index="2" size="512"/>

    <buttons names="Accel,Brake,View,Up,Start,Coin,Test" default="A,B,X,Y,Start,Select,L"/>
</misterromdescription>
