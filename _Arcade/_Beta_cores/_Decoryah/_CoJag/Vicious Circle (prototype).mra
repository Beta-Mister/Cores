<misterromdescription>
    <name>Vicious Circle (prototype)</name>
    <setname same_dir="1">vcircle</setname>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Atari Games</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <rbf>cojagr3k</rbf>
    <platform>Atari CoJag</platform>

    <!--
      Image for the CoJag core (tools/cojag_rom.py):
        0x000000 the main CPU program, 2 MB, big-endian      0x200000 the ROM board, 16 MB (ROM board sets)
      Index 1: the board: bit 0 R3041, bit 1 ROM board, bits 3-2 inputs (0 light guns, 1 joysticks + 3 buttons,
      2 joysticks + 6 buttons). No DIP switches: the settings are in the EEPROM (index 4); change them in the
      game's test menu (OSD: Service Mode).
      The disk: games/cojag/vcircle.hdd, the raw image of MAME's vcircle.chd (chdman extracthd; the image's SHA1 is
      the CHD's "Data SHA1"; the CHD's own SHA1 is bfa79c4cacdc9c2cd6362f62a23056b3e35a2034). The <file> below mounts it on a Main_MiSTer
      with MRA mounting (master of 2026-11-02 or later); with an older one, choose it once under "Disk image"
      in the OSD (it opens in games/cojag: same_dir) and the core mounts it again at each load.
      Made by tools/make_mra.py from MAME 0.289 (src/mame/atari/jaguar.cpp); parts are found by name and CRC.
    -->

    <file delay="1" type="s" index="0" root="games" path="cojag/vcircle.hdd"/>

    <rom index="1">
        <part>09</part>
    </rom>

    <rom index="0" zip="vcircle.zip" md5="054cb471399edb690d79d02920b0bda9" address="0x38000000">
        <!-- 0x000000 the main CPU program, ROM_LOAD32_BYTE (big-endian: offset 0 = D31-24) -->
        <interleave output="32">
            <part name="hh" crc="7276f5f5" map="0001"/>
            <part name="hl" crc="146060a1" map="0010"/>
            <part name="lh" crc="be4b2ef6" map="0100"/>
            <part name="ll" crc="ba8753eb" map="1000"/>
        </interleave>
    </rom>

    <nvram index="4" size="2048"/>

    <buttons names="Quick Punch,Kick,High Kick,Special,Lunge Punch,Heavy Swing,Start,Coin" default="A,B,X,Y,R,L,Start,Select"/>
</misterromdescription>
