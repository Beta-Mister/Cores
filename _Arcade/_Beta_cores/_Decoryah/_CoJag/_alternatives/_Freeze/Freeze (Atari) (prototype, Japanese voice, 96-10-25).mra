<misterromdescription>
    <name>Freeze (Atari) (prototype, Japanese voice, 96/10/25)</name>
    <setname>freezeatjp</setname>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Atari Games</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <rbf>cojagr3k</rbf>
    <platform>Atari CoJag</platform>

    <!--
      Image for the CoJag core (tools/cojag_rom.py):
        0x000000 the main CPU program, 2 MB, big-endian      0x200000 the ROM board, 16 MB (ROM board sets)
      Index 1: the board: bit 0 R3041, bit 1 ROM board, bits 3-2 inputs (0 light guns, 1 joysticks + 3 buttons,
      2 joysticks + 6 buttons). No DIP switches: the settings are in the EEPROM (index 4); change them in the
      game's test menu (OSD: Service Mode).
      Made by tools/make_mra.py from MAME 0.289 (src/mame/atari/jaguar.cpp); parts are found by name and CRC.
    -->

    <rom index="1">
        <part>07</part>
    </rom>

    <rom index="0" zip="freezeatjp.zip|freezeat.zip" md5="d89c69d637deb07a4071f88c9633f010" address="0x38000000">
        <!-- 0x000000 the main CPU program, ROM_LOAD32_BYTE (big-endian: offset 0 = D31-24) -->
        <interleave output="32">
            <part name="prog_jpn.hh" crc="989302bf" map="0001"/>
            <part name="prog_jpn.hl" crc="6262b760" map="0010"/>
            <part name="prog_jpn.lh" crc="c6a12b0c" map="0100"/>
            <part name="prog_jpn.ll" crc="241ea755" map="1000"/>
        </interleave>
        <part repeat="0x100000">00</part>
        <!-- 0x200000 the ROM board, ROM_LOAD64_BYTE (big-endian: offset 0 = D63-56) -->
        <!-- romboard 0x000000-0x7FFFFF -->
        <interleave output="64">
            <part name="fish_gr0.63-56" crc="b61061c5" map="00000001"/>
            <part name="fish_gr0.55-48" crc="c85acf42" map="00000010"/>
            <part name="fish_gr0.47-40" crc="67f78f59" map="00000100"/>
            <part name="fish_gr0.39-32" crc="6be0508a" map="00001000"/>
            <part name="fish_gr0.31-24" crc="905606e0" map="00010000"/>
            <part name="fish_gr0.23-16" crc="cdeef6fa" map="00100000"/>
            <part name="fish_gr0.15-08" crc="ad81f204" map="01000000"/>
            <part name="fish_gr0.07-00" crc="10ce7254" map="10000000"/>
        </interleave>
        <!-- romboard 0x800000-0xFFFFFF -->
        <interleave output="64">
            <part name="fish_jpn.63-56" crc="78c65a1f" map="00000001"/>
            <part name="fish_jpn.55-48" crc="9ffac0f1" map="00000010"/>
            <part name="fish_jpn.47-40" crc="18543fb7" map="00000100"/>
            <part name="fish_jpn.39-32" crc="22578f15" map="00001000"/>
            <part name="fish_jpn.31-24" crc="5c41b91b" map="00010000"/>
            <part name="fish_jpn.23-16" crc="c2462646" map="00100000"/>
            <part name="fish_jpn.15-08" crc="f8d998ec" map="01000000"/>
            <part name="fish_jpn.07-00" crc="e7e0daa5" map="10000000"/>
        </interleave>
    </rom>

    <nvram index="4" size="2048"/>

    <buttons names="Toss,-,-,-,-,-,Start,Coin" default="A,B,X,Y,R,L,Start,Select"/>
</misterromdescription>
