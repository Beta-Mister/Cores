<misterromdescription>
    <name>Area 51 (Time Warner license, Oct 17, 1996)</name>
    <setname same_dir="1">area51t</setname>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Atari Games (Time Warner license)</manufacturer>
    <players>2</players>
    <rotation>horizontal</rotation>
    <rbf>cojag020</rbf>
    <platform>Atari CoJag</platform>

    <!--
      Image for the CoJag core (tools/cojag_rom.py):
        0x000000 the main CPU program, 2 MB, big-endian      0x200000 the ROM board, 16 MB (ROM board sets)
      Index 1: the board: bit 0 R3041, bit 1 ROM board, bits 3-2 inputs (0 light guns, 1 joysticks + 3 buttons,
      2 joysticks + 6 buttons). No DIP switches: the settings are in the EEPROM (index 4); change them in the
      game's test menu (OSD: Service Mode).
      The disk: games/cojag/area51t.hdd, the raw image of MAME's area51t.chd (chdman extracthd; the image's SHA1 is
      the CHD's "Data SHA1"; the CHD's own SHA1 is d2865cc7b1bb08a4393a72013a90e18d8a8f9860). The <file> below mounts it on a Main_MiSTer
      with MRA mounting (master of 2026-11-02 or later); with an older one, choose it once under "Disk image"
      in the OSD (it opens in games/cojag: same_dir) and the core mounts it again at each load.
      Made by tools/make_mra.py from MAME 0.289 (src/mame/atari/jaguar.cpp); parts are found by name and CRC.
    -->

    <file delay="1" type="s" index="0" root="games" path="cojag/area51t.hdd"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="area51t.zip|area51.zip" md5="0e7eb3e48c854a1c0f381bc06b38227c" address="0x38000000">
        <!-- 0x000000 the main CPU program, ROM_LOAD32_BYTE (big-endian: offset 0 = D31-24) -->
        <interleave output="32">
            <part name="136105-0003-q_h.3h" crc="0681f398" map="0001"/>
            <part name="136105-0002-q_p.3p" crc="f76cfc68" map="0010"/>
            <part name="136105-0001-q_m.3m" crc="f422b4a8" map="0100"/>
            <part name="136105-0000-q_k.3k" crc="1fb2f2b5" map="1000"/>
        </interleave>
    </rom>

    <nvram index="4" size="2048"/>

    <buttons names="Trigger,Reload,-,-,-,-,Start,Coin" default="A,B,X,Y,R,L,Start,Select"/>
</misterromdescription>
