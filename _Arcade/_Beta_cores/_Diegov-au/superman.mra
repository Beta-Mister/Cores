<misterromdescription>
    <name>Superman</name>
    <setname>superman</setname>
    <year>1988</year>
    <manufacturer>Taito</manufacturer>
    <rbf>superman</rbf>
    <region>World</region>

    <!-- Layout must match tools/mkrom.py LAYOUT and the decode in
         rtl/superman_core.sv. All three are generated from or checked
         against the same table; if you change one, change all. -->
    <rom index="0" zip="superman.zip" type="merged" md5="none">
        <!-- maincpu @ 0x000000 -->
        <interleave output="16">
            <part name="b61_09.a10" crc="640f1d58" map="01"/>
            <part name="b61_07.a5" crc="fddb9953" map="10"/>
        </interleave>
        <!-- maincpu @ 0x000000 -->
        <interleave output="16">
            <part name="b61_08.a8" crc="79fc028e" map="01"/>
            <part name="b61_13.a3" crc="9f446a44" map="10"/>
        </interleave>
        <!-- audiocpu @ 0x080000 -->
        <part name="b61_10.d18" crc="6efe79e8"/>
        <!-- gfx1 @ 0x090000 -->
        <interleave output="32">
            <part name="b61-16.j1" crc="3622ed2f" map="0012"/>
            <part name="b61-14.f1" crc="89368c3e" map="1200"/>
        </interleave>
        <!-- gfx1 @ 0x090000 -->
        <interleave output="32">
            <part name="b61-17.k1" crc="c34f27e0" map="0012"/>
            <part name="b61-15.h1" crc="910cc4f9" map="1200"/>
        </interleave>
        <!-- adpcma @ 0x290000 -->
        <part name="b61-01.e18" crc="3cf99786"/>
        <!-- cchip_eprom @ 0x310000 -->
        <part name="b61_11.m11" crc="3bc5d44b"/>
        <!-- C-Chip uPD78C11 internal mask ROM, shared by every
             C-Chip game; MAME ships it as the cchip device set. -->
        <part name="cchip_upd78c11.bin" crc="43021521" zip="cchip.zip"/>
    </rom>
</misterromdescription>
