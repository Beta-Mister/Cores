<misterromdescription>
    <name>Batsugun (Korean PCB, ToaplanV25)</name>
    <setname>batsugunb</setname>
    <rbf>ToaplanV25</rbf>
    <mameversion>0288</mameversion>
    <year>1993</year>
    <manufacturer>Toaplan</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <platform>Toaplan TP-030</platform>
    <category>Shoot'em up</category>
    <buttons names="Shot,Bomb,-,Start,Coin,Pause,-,-,-,Savestates,2P Start" default="A,B,Start,Select,R,L," count="3"/>
    <switches default="00,00,90">
        <dip name="Continue Price" bits="0" ids="Normal,Discount"/>
        <dip name="Service Mode" bits="2" ids="Off,On"/>
        <dip name="Demo Sounds" bits="3" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="1/1,1/2,2/1,2/3"/>
        <dip name="Coin B" bits="6,7" ids="1/1,1/2,2/1,2/3"/>
        <dip name="Difficulty" bits="8,9" ids="Normal,Easy,Hard,Very Hard"/>
        <dip name="Bonus Life" bits="10,11" ids="1000k only,500k then +600k,1500k only,None"/>
        <dip name="Lives" bits="12,13" ids="3,5,2,1"/>
        <dip name="Invulnerability" bits="14" ids="Off,On"/>
        <dip name="Allow Continue" bits="15" ids="Yes,No"/>
    </switches>
    <rom index="1"><part>00</part></rom>
    <rom index="5"><part>01 04 00 00 4d 55 5d 86 10 9e 00 04 00 00 11 66 00 50 00 15 11 b6 00 20 00 00 10 de 00 30 98 fb</part></rom>
    <nvram index="2" size="172"/>
