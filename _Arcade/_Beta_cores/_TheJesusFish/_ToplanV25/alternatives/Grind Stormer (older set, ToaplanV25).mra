<misterromdescription>
    <name>Grind Stormer (older set, ToaplanV25)</name>
    <setname>grindstma</setname>
    <rbf>ToaplanV25</rbf>
    <mameversion>0288</mameversion>
    <year>1992</year>
    <manufacturer>Toaplan</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <platform>Toaplan TP-027</platform>
    <category>Shoot'em up</category>
    <buttons names="Shot,Bomb,-,Start,Coin,Pause,-,-,-,Savestates" default="A,B,Start,Select,R,L" count="3"/>
    <switches default="00,00,90">
        <dip name="Cabinet" bits="0" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="2" ids="Off,On"/>
        <dip name="Demo Sounds" bits="3" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="1/1,2/1,3/1,4/1"/>
        <dip name="Coin B" bits="6,7" ids="1/2,1/3,1/4,1/6"/>
        <dip name="Difficulty" bits="8,9" ids="Normal,Easy,Hard,Very Hard"/>
        <dip name="Bonus Life" bits="10,11" ids="300k and 800k,300k then +800k,200k only,None"/>
        <dip name="Lives" bits="12,13" ids="3,5,2,1"/>
        <dip name="Invulnerability" bits="14" ids="Off,On"/>
        <dip name="Allow Continue" bits="15" ids="Yes,No"/>
    </switches>
    <rom index="1"><part>01</part></rom>
    <rom index="5"><part>01 03 01 00 d2 45 f6 88 04 fc 00 90 00 00 05 7b 00 01 2d 2d 04 38 00 04 00 00</part></rom>
    <nvram index="2" size="157"/>
    <rom index="0" zip="grindstma.zip|grindstm.zip" md5="None">
        <part name="tp027-01.rom" crc="8d8c0392"/>
        <part name="tp027_02.bin" crc="877b45e8"/>
        <part name="tp027_03.bin" crc="b1fc6362"/>
    </rom>
</misterromdescription>
