  <buttons names="Shot,Shot 2,Start,Coin,Service,Tilt,Pause" default="A,B,Start,Select,R,L,X" count="2"/>
  <!-- board mode 5; fixed index-0 image = 0xB00000 bytes -->
  <rom index="0" zip="missw02d.zip|missw02.zip|fantsia2.zip">
    <!-- main/program+bitmap data: fixed slot 0x500000 bytes -->
    <interleave input="8" output="16">
      <part name="8.u81" crc="316666d0" map="0001"/>
      <part name="7.u80" crc="d61f4d18" map="0010"/>
    </interleave>
    <interleave output="16">
      <part name="3.bin" crc="fdfe36ba" map="21"/>
    </interleave>
    <interleave output="16">
      <part name="4.bin" crc="aa769a81" map="21"/>
    </interleave>
    <!-- Kaneko sprite ROM: fixed slot 0x200000 bytes -->
      <part name="6.u113" crc="3e77ca1f"/>
      <part name="5.u112" crc="ead3411d"/>
    <part repeat="0x100000"> FF </part>
    <!-- MSM6295 samples: fixed slot 0x200000 bytes -->
      <part name="2.u4" crc="06dc889e"/>
      <part name="1.u1" crc="864167c2"/>
    <part repeat="0x100000"> FF </part>
    <!-- VIEW2 raw/encrypted tiles: fixed slot 0x200000 bytes -->
    <part repeat="0x200000"> FF </part>
  </rom>
  <rom index="1"><part>05</part></rom>
</misterromdescription>
