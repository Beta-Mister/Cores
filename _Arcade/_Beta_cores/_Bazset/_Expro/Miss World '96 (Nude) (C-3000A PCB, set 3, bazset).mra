      <part name="mw96n3_10.prog2" crc="67bde86b" map="0001"/>
      <part name="mw96n3_6.prog1" crc="de99cc48" map="0010"/>
    </interleave>
    <interleave input="8" output="16">
      <part name="mw96_09.bin" crc="7032dfdf" map="0001"/>
      <part name="mw96_05.bin" crc="91de5ab5" map="0010"/>
    </interleave>
    <interleave input="8" output="16">
      <part name="mw96_08.bin" crc="b8e66fb5" map="0001"/>
      <part name="mw96_04.bin" crc="e77a04f8" map="0010"/>
    </interleave>
    <interleave input="8" output="16">
      <part name="mw96_07.bin" crc="26112ed3" map="0001"/>
      <part name="mw96_03.bin" crc="e9374a46" map="0010"/>
    </interleave>
    <part repeat="0x100000"> FF </part>
    <!-- Kaneko sprite ROM: fixed slot 0x200000 bytes -->
      <part name="mw96_11.bin" crc="3983152f"/>
    <part repeat="0x180000"> FF </part>
    <!-- MSM6295 samples: fixed slot 0x200000 bytes -->
      <part name="mw96_01.bin" crc="e78a659e"/>
