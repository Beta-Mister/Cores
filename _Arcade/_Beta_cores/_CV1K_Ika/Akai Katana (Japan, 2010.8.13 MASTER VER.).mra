<!--
  ikacore_CV1k MRA - Akai Katana (Japan, 2010/8/13 MASTER VER.).

  DELIVERY: the NAND and YMZ images do not stream over the ioctl/SPI
  lane. Both roms carry an `address=` attribute, so Main_MiSTer
  assembles them and memcpys them straight into DDR3. Only u4 streams.

  Rom order is deliberate - DDR3 first, index 0 LAST. Index 0's download
  is what finally releases the CPU, so every image is in place before the
  core runs.

    <rom index="1">  DDR3 0x34400000  u2  NAND dump incl. spare
    <rom index="2">  DDR3 0x3C800000  u23 YMZ chip 0, zero-padded to 8 MiB
                     DDR3 0x3D000000  u24 YMZ chip 1, zero-padded to 8 MiB
    <rom index="0">  ioctl stream     u4  program NOR x1 (4 MiB)
-->
<misterromdescription>
    <about author="ika-musume" source="https://github.com/ika-musume/ikacore_CV1k"/>
    <name>Akai Katana (Japan, 2010/ 8/13 MASTER VER.)</name>
    <setname>akatana</setname>
    <year>2010</year>
    <manufacturer>Cave</manufacturer>
    <category>Shooter</category>
    <rbf>ikacore_CV1k</rbf>

    <rom index="1" address="0x34400000" zip="akatana.zip" md5="none">
        <part name="u2" crc="89a2e1a5"/>
    </rom>

    <rom index="2" address="0x3C800000" zip="akatana.zip" md5="none">
        <part name="u23" crc="34a67e24"/>
        <part repeat="0x400000">00</part>
        <part name="u24" crc="10760fed"/>
        <part repeat="0x400000">00</part>
    </rom>

    <nvram index="3" size="135680"/>

    <rom index="0" zip="akatana.zip" md5="none">
        <part name="u4" crc="613fd380"/>
    </rom>

    <buttons names="B1,B2,B3,B4,Start,Coin,Test,Service,Save State" default="A,B,X,Y,Start,R,L,Select"/>
</misterromdescription>
