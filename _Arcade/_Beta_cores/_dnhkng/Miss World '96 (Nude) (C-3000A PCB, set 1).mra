<!-- Experimental Miss World '96 MiSTer MRA.
     This targets the best-guess jtmissw96 RBF and contains no ROM data.
-->

<misterromdescription>
    <about author="dnhkng; based on Jotego JTGALS structure" webpage="https://github.com/dnhkng/MissWorld96_MiSTer" source="https://github.com/dnhkng/MissWorld96_MiSTer"/>
    <rotation>horizontal</rotation>
    <name>Miss World '96 (Nude) (C-3000A PCB, set 1)</name>
    <setname>missw96</setname>
    <mameversion>0288</mameversion>
    <year>1996</year>
    <manufacturer>Comad</manufacturer>
    <players>2</players>
    <rbf>jtmissw96</rbf>
    <joystick>4</joystick>
    <region>World</region>
    <rom index="0" zip="missw96.zip" md5="None">
        <!-- Byte 0:
             bit 0 = experimental Comad OKI status/timer compatibility -->
        <part>
            01 00 00 00 </part>
        <!-- maincpu - starts at 0x0 - region length 0x500000 -->
        <interleave output="16">
            <part name="mw96_10.bin" crc="b1309bb1" map="10"/>
            <part name="mw96_06.bin" crc="a5892bb3" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="mw96_09.bin" crc="7032dfdf" map="10"/>
            <part name="mw96_05.bin" crc="91de5ab5" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="mw96_08.bin" crc="b8e66fb5" map="10"/>
            <part name="mw96_04.bin" crc="e77a04f8" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="mw96_07.bin" crc="26112ed3" map="10"/>
            <part name="mw96_03.bin" crc="e9374a46" map="01"/>
        </interleave>
        <part repeat="0x100000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- oki - starts at 0x500000 - length 0x100000 -->
        <part name="mw96_01.bin" crc="e78a659e"/>
        <part name="mw96_02.bin" crc="60fa0c00"/>
        <!-- JTFRAME_BA2_START -->
        <!-- kan_spr - starts at 0x600000 - length 0x80000 -->
        <part name="mw96_11.bin" crc="3983152f"/>
        <!-- Total 0x680000 bytes - 6656 kBytes -->
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <DSW1/>
        <dip name="Difficulty" bits="0,1" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Lives" bits="4,5" ids="5,2,4,3"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On"/>
        <DSW2/>
        <dip name="Coin Mode" bits="11" ids="Mode 2,Mode 1"/>
        <dip name="Coin A" bits="12,13" ids="1/4 or 1/6,1/2 or 1/3,2/1,1/1"/>
        <dip name="Coin B" bits="14,15" ids="1/4 or 1/6,1/2 or 1/3,2/1,1/1"/>
    </switches>
    <buttons names="Cut,Unused,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
