    <part name="prm40.ic21" crc="87d12d57" />
  </rom>
  <!-- core_mod: bit 0 vertical screen; bit 2 set: JTFRAME XORs it with
       dip_flip (high while OSD Flip screen is Off) to choose the frame
       buffer's direction, so set it turns the picture clockwise while the
       flip is off, as the cabinet's monitor is turned -->
  <rom index="1">
    <part>05 80</part>
  </rom>
  <!-- The boards' setting switches (OSD "DIP Switches"), 0 = the default:
       bit 0, sheet A's changeover switch; bit 8, DIP SW. 2's contact that
       sends the back sound (D-2, R424) into the front speaker's mix;
       bit 9, DIP SW. 2 contact 2-15 (R423, a louder explosion).
       jtmonacogp_game.v reads them from dipsw. -->
  <switches default="00,00" base="16" page_id="1" page_name="Switches">
    <dip name="Coin, play" bits="0" ids="1 coin 1 play,1 coin 2 plays" />
    <dip name="Back sound in front mix" bits="8" ids="On,Off" />
    <dip name="Louder explosion" bits="9" ids="Off,On" />
  </switches>
  <nvram index="2" size="514" />
</misterromdescription>
