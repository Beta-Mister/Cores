<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Osman (World)</name>
    <setname>osman</setname>
    <mameversion>0282</mameversion>
    <year>1996</year>
    <manufacturer>Mitchell</manufacturer>
    <players>2</players>
    <rbf>jtosman</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="osman.zip" md5="None">
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="sa00-0.1e" crc="ec6b3257" map="12"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- tiles - starts at 0x80000 - length 0x200000 (21 bits) -->
        <part name="mcf-00.9a" crc="247712dc"/>
        <!-- PCM1_START -->
        <!-- JTFRAME_BA2_START -->
        <!-- oki1 - starts at 0x280000 - length 0x40000 (18 bits) -->
        <part name="sa01-0.13h" crc="cea8368e"/>
        <!-- PCM2_START -->
        <!-- oki2 - starts at 0x2C0000 - length 0x200000 (21 bits) -->
        <part name="mcf-05.12f" crc="f007d376"/>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x4C0000 - length 0x800000 (23 bits) -->
        <part name="mcf-04.14h" crc="4fa55577"/>
        <part name="mcf-03.14d" crc="faf1d51d"/>
        <part name="mcf-02.14a" crc="21251b33"/>
        <part name="mcf-01.13a" crc="83881e25"/>
        <!-- eeprom - starts at 0xCC0000 - length 0x80 (7 bits) -->
        <part name="eeprom-osman.bin" crc="509552b2"/>
        <!-- Total 0xCC0080 bytes - 13056 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <buttons names="Attack,Jump,Special,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
