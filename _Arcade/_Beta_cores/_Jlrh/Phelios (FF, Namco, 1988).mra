        <!-- 0x280000: [1/2] RELLENO EXPLICITO, no un hueco olvidado. La region anterior mide 0x1c0000 (1,75 MB) y omf_mem le da capacidad 2^21 = 2 MB (potencia de dos obligatoria), asi que sobran 0x040000. Sin el relleno, `omf_mem check` marcaria solape con la region siguiente. -->
        <part repeat="262144">FF</part>
        <!-- 0x2c0000: graficos del ROZ (s2roz, 896 KB REALES = 7 x 128 KB) -- misma region de 4 MB, mismo macro y mismo espejo que c123tmap, mismo doblado de A18:A17 en el RTL -->
        <part name="ps_roz-0.roz0" crc="68043d7e"/>
        <part name="ps_roz-1.roz1" crc="029802b4"/>
        <part name="ps_roz-2.roz2" crc="bf0b76dc"/>
        <part name="ps_roz-3.roz3" crc="9c821455"/>
        <part name="ps_roz-4.roz4" crc="63a39b7a"/>
        <part name="ps_roz-5.roz5" crc="fc5a99d0"/>
        <part name="ps_roz-6.roz6" crc="a2a17587"/>
        <!-- 0x3a0000: [2/2] RELLENO EXPLICITO, no un hueco olvidado, y su VALOR NO ES LIBRE: es la RANURA 7 del doblado del ROZ (slot = A21:A19 sobre la region de 4 MB de MAME, offset = A16:0, se doblan A18:A17). MAME deja esa ranura a CEROS -- ROM_REGION se rellena de cero y NAMCOS2_GFXROM_LOAD_128K solo carga 7 ficheros -- y el ROZ SI la dibuja: MEDIDO sobre los 246 volcados, 4.096 texeles muestreados en 2 de los 118 frames con ROZ (la pantalla de POST con recorte de 64x64, donde el 100 % de los texeles caen ahi). Con 0xFF esos pixeles saldrian TRANSPARENTES (0xFF es el pen transparente del ROZ) en vez de color+0, o sea un cuadro de 64x64 que falta. Por eso el relleno es 00 y no FF. ⚠ El tilemap NO tiene este problema porque su ranura 7 no se usa nunca (medido: 0 de 4,5 millones de lecturas), asi que ahi el 0xFF es indiferente -- la diferencia entre las dos regiones esta MEDIDA, no supuesta. Y la razon original del relleno sigue en pie: el cliente del arbitro solo puede tener capacidad POTENCIA DE DOS (omf_mem: 2^addr_bits), asi que sin este bloque `omf_mem check` marcaria SOLAPE con la region siguiente. Cuesta 128 KB de descarga. -->
        <part repeat="131072">00</part>
        <!-- 0x3c0000: graficos de SPRITES (sprite, 2 MB REALES = 8 x 256 KB). ⚠ ROM_REGION es 0x400000 = 4 MB: NAMCOS2_SPRROM_LOAD_256K anade un ROM_RELOAD a +0x100000 que HEREDA las banderas, o sea que repite el entrelazado. La region queda [A][A][B][B] -&gt; el RTL dobla A20. ORDEN DE BYTE INVERTIDO (start 3,2,1,0): obj0 aporta el byte 3 del dword y obj3 el byte 0 -->
        <!-- bloque A: obj0-3 -&gt; 1 MB (region 0x000000-0x0FFFFF, espejado en 0x100000-0x1FFFFF) -->
        <interleave output="32">
            <part name="ps_obj-0.obj0" crc="f323db2b" map="1000"/>
            <part name="ps_obj-1.obj1" crc="faf7c2f5" map="0100"/>
            <part name="ps_obj-2.obj2" crc="828178ba" map="0010"/>
            <part name="ps_obj-3.obj3" crc="e84771c8" map="0001"/>
        </interleave>
        <!-- bloque B: obj4-7 -&gt; 1 MB (region 0x200000-0x2FFFFF, espejado en 0x300000-0x3FFFFF) -->
        <interleave output="32">
            <part name="ps_obj-4.obj4" crc="81ea86c6" map="1000"/>
            <part name="ps_obj-5.obj5" crc="aaebd51a" map="0100"/>
            <part name="ps_obj-6.obj6" crc="032ea497" map="0010"/>
            <part name="ps_obj-7.obj7" crc="f6183b36" map="0001"/>
        </interleave>
        <!-- 0x5c0000: muestras PCM del C140 (c140, 512 KB REALES). ⚠ ROM_REGION16_BE es 0x200000 con ERASE00 y ps_voi-1 se carga con ROM_LOAD16_BYTE en el offset 0 -&gt; ocupa los bytes PARES del primer MB, o sea el byte ALTO de cada palabra BE. c140_rom_r (namcos2_m.cpp:369-395) lee `region[romsel&lt;&lt;19 | (offset &amp; 0x7ffff)] &amp; 0xff00`, o sea el byte k del fichero ES la muestra del indice de palabra k: aqui se descarga PLANO y el RTL devuelve {voi1[A18:0], 8'h00}. Phelios no lleva voice0 (nibble bajo) ni voice2 (romsel=1): los dos son 0 -->
        <part name="ps_voi-1.voice1" crc="f67376ed"/>
        <!-- 0x640000: MCU C65 (HD63705): ROM EXTERNA de 32 KB, especifica del juego -->
        <part name="sys2_c65c.3f" crc="a5b2a4ff"/>
        <!-- 0x648000: MCU C65: ROM INTERNA de 8 KB (sys2mcpu.bin), comun a TODOS los Namco System 2 -- vive en el romset de DISPOSITIVO namcoc65.7z, no en phelios.7z. Solo hace falta si el C65 se hace LLE; se descarga igual porque son 8 KB y decidirlo despues no cuesta nada -->
        <part name="sys2mcpu.bin" crc="a342a97e"/>
